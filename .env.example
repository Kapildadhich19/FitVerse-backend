NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fitverse:fitverse@localhost:5432/fitverse?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=fitverse_refresh_token
PRODUCT_PARSE_TIMEOUT_MS=8000
FRONTEND_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=replace-with-the-same-long-random-token-used-by-ai-service
AI_SERVICE_TIMEOUT_MS=120000
MESHY_API_KEY=your-meshy-api-key
MESHY_MODEL=meshy-7.1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
